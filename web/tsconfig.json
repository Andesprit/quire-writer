{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "main.ts",
    "ui.ts",
    "format.ts",
    "chat.ts",
    "merge.ts",
    "highlight.ts",
    "markdown.ts",
    "pdf.ts"
  ]
}